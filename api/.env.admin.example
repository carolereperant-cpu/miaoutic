# ============================================================
# Settings of scripts/executer-sql.js (creation of the database
# online). Copy this file to ".env.admin" and fill in the values
# given by Aiven (page of the service, "Connection information").
# The .env.admin file is ignored by Git: it never goes to GitHub.
# ============================================================

# Administrator account of the hosted database (Aiven: avnadmin)
ADMIN_DB_HOST=
ADMIN_DB_PORT=
ADMIN_DB_USER=avnadmin
ADMIN_DB_PASSWORD=

# Certificate of the authority, downloaded from Aiven (ca.pem)
DB_SSL_CA_FILE=./ca.pem

# Password of the account used by the API (miaoutic_app): choose a
# new one, at least 16 characters. It must also be given to Render
# (variable DB_PASSWORD of the API).
APP_DB_PASSWORD=
