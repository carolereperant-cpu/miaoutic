# ============================================================
# Copy this file to ".env" and fill in your own values.
# The .env file is ignored by Git: it never goes to GitHub.
# ============================================================

# Port of the API
PORT=3000

# Address of the front-end allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5173

# Database (XAMPP: MySQL / MariaDB on port 3306)
# Use the restricted account created by database/02_users.sql, never root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=miaoutic_app
DB_PASSWORD=
DB_NAME=miaoutic

# Secret key used to sign the login tokens (JWT): at least 32 characters.
# Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Lifetime of a login token
JWT_EXPIRES_IN=2h

# Failed login / sign-up attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT=10

# Production only: number of reverse proxies in front of the API
# (1 behind Nginx), so that the real IP of each visitor is used.
# Keep 0 in development.
TRUST_PROXY=0
